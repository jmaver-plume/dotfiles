#!/usr/bin/env bash

set -Eeuo pipefail

DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

create_symlink() {
    local source="$1"
    local target="$2"

    [[ "$source" != /* ]] && source="$DOTFILES_DIR/$source"

    if [[ ! -e "$source" ]]; then
        echo "Source does not exist: $source" >&2
        return 1
    fi

    if [[ -L "$target" ]]; then
        if [[ "$(readlink "$target")" == "$source" ]]; then
            echo "Already linked: $target"
            return 0
        fi

        rm "$target"
    elif [[ -e "$target" ]]; then
        echo "Target already exists and is not a symlink: $target" >&2
        return 1
    fi

    mkdir -p "$(dirname "$target")"
    ln -s "$source" "$target"
    echo "Linked: $target -> $source"
}

configure_git() {
    local config_file="$DOTFILES_DIR/gitconfig"

    if git config --global --get-all include.path 2>/dev/null | grep -Fqx "$config_file"; then
        echo "Already configured: Git defaults"
    else
        git config --global --add include.path "$config_file"
        echo "Configured Git to include: $config_file"
    fi
}

if ! command -v brew >/dev/null 2>&1; then
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

if command -v brew >/dev/null 2>&1; then
    BREW_BIN="$(command -v brew)"
elif [[ -x /opt/homebrew/bin/brew ]]; then
    BREW_BIN=/opt/homebrew/bin/brew
elif [[ -x /usr/local/bin/brew ]]; then
    BREW_BIN=/usr/local/bin/brew
else
    echo "Homebrew was not found after installation." >&2
    exit 1
fi

eval "$("$BREW_BIN" shellenv)"
brew bundle install --no-upgrade --file="$DOTFILES_DIR/Brewfile"
git -C "$DOTFILES_DIR" submodule update --init --recursive -- \
    fzf-tab kickstart.nvim zsh-autosuggestions

create_symlink ".hushlogin" "$HOME/.hushlogin"
create_symlink ".ideavimrc" "$HOME/.ideavimrc"
create_symlink ".zshrc" "$HOME/.zshrc"
create_symlink "ghostty" "$HOME/.config/ghostty/config"
create_symlink "zsh-autosuggestions" "$HOME/.zsh/zsh-autosuggestions"
create_symlink "fzf-tab" "$HOME/.zsh/fzf-tab"
create_symlink "kickstart.nvim" "$HOME/.config/nvim"
configure_git

echo "Done!"
